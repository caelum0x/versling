[{"surah": 93, "ayah": 1, "arabic": "بِسمِ اللَّهِ الرَّحمٰنِ الرَّحيمِ وَالضُّحىٰ", "transliteration": "Waaldduha", "translation": "By the morning hours"}, {"surah": 93, "ayah": 2, "arabic": "وَالَّيلِ إِذا سَجىٰ", "transliteration": "Waallayli itha saja", "translation": "And by the night when it is stillest"}, {"surah": 93, "ayah": 3, "arabic": "ما وَدَّعَكَ رَبُّكَ وَما قَلىٰ", "transliteration": "Ma waddaAAaka rabbuka wama qala", "translation": "Thy Lord hath not forsaken thee nor doth He hate thee"}, {"surah": 93, "ayah": 4, "arabic": "وَلَلءاخِرَةُ خَيرٌ لَكَ مِنَ الأولىٰ", "transliteration": "Walalakhiratu khayrun laka mina aloola", "translation": "And verily the latter portion will be better for thee than the former"}, {"surah": 93, "ayah": 5, "arabic": "وَلَسَوفَ يُعطيكَ رَبُّكَ فَتَرضىٰ", "transliteration": "Walasawfa yuAAteeka rabbuka fatarda", "translation": "And verily thy Lord will give unto thee so that thou wilt be content"}, {"surah": 93, "ayah": 6, "arabic": "أَلَم يَجِدكَ يَتيمًا فَـٔاوىٰ", "transliteration": "Alam yajidka yateeman faawa", "translation": "Did He not find thee an orphan and protect (thee)"}, {"surah": 93, "ayah": 7, "arabic": "وَوَجَدَكَ ضالًّا فَهَدىٰ", "transliteration": "Wawajadaka dallan fahada", "translation": "Did He not find thee wandering and direct (thee)"}, {"surah": 93, "ayah": 8, "arabic": "وَوَجَدَكَ عائِلًا فَأَغنىٰ", "transliteration": "Wawajadaka AAailan faaghna", "translation": "Did He not find thee destitute and enrich (thee)"}, {"surah": 93, "ayah": 9, "arabic": "فَأَمَّا اليَتيمَ فَلا تَقهَر", "transliteration": "Faamma alyateema fala taqhar", "translation": "Therefor the orphan oppress not"}, {"surah": 93, "ayah": 10, "arabic": "وَأَمَّا السّائِلَ فَلا تَنهَر", "transliteration": "Waamma alssaila fala tanhar", "translation": "Therefor the beggar drive not away"}, {"surah": 93, "ayah": 11, "arabic": "وَأَمّا بِنِعمَةِ رَبِّكَ فَحَدِّث", "transliteration": "Waamma biniAAmati rabbika fahaddith", "translation": "Therefor of the bounty of thy Lord be thy discourse"}]