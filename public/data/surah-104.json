[{"surah": 104, "ayah": 1, "arabic": "بِسمِ اللَّهِ الرَّحمٰنِ الرَّحيمِ وَيلٌ لِكُلِّ هُمَزَةٍ لُمَزَةٍ", "transliteration": "Waylun likulli humazatin lumazatin", "translation": "Woe unto every slandering traducer"}, {"surah": 104, "ayah": 2, "arabic": "الَّذى جَمَعَ مالًا وَعَدَّدَهُ", "transliteration": "Allathee jamaAAa malan waAAaddadahu", "translation": "Who hath gathered wealth (of this world) and arranged it"}, {"surah": 104, "ayah": 3, "arabic": "يَحسَبُ أَنَّ مالَهُ أَخلَدَهُ", "transliteration": "Yahsabu anna malahu akhladahu", "translation": "He thinketh that his wealth will render him immortal"}, {"surah": 104, "ayah": 4, "arabic": "كَلّا لَيُنبَذَنَّ فِى الحُطَمَةِ", "transliteration": "Kalla layunbathanna fee alhutamati", "translation": "Nay, but verily he will be flung to the Consuming One"}, {"surah": 104, "ayah": 5, "arabic": "وَما أَدرىٰكَ مَا الحُطَمَةُ", "transliteration": "Wama adraka ma alhutamatu", "translation": "Ah, what will convey unto thee what the Consuming One is"}, {"surah": 104, "ayah": 6, "arabic": "نارُ اللَّهِ الموقَدَةُ", "transliteration": "Naru Allahi almooqadatu", "translation": "(It is) the fire of Allah, kindled"}, {"surah": 104, "ayah": 7, "arabic": "الَّتى تَطَّلِعُ عَلَى الأَفـِٔدَةِ", "transliteration": "Allatee tattaliAAu AAala alafidati", "translation": "Which leapeth up over the hearts (of men)"}, {"surah": 104, "ayah": 8, "arabic": "إِنَّها عَلَيهِم مُؤصَدَةٌ", "transliteration": "lnnaha AAalayhim musadatun", "translation": "Lo! it is closed in on them"}, {"surah": 104, "ayah": 9, "arabic": "فى عَمَدٍ مُمَدَّدَةٍ", "transliteration": "Fee AAamadin mumaddadatin", "translation": "In outstretched columns"}]