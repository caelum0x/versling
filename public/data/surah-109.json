[{"surah": 109, "ayah": 1, "arabic": "بِسمِ اللَّهِ الرَّحمٰنِ الرَّحيمِ قُل يٰأَيُّهَا الكٰفِرونَ", "transliteration": "Qul ya ayyuha alkafiroona", "translation": "Say: O disbelievers"}, {"surah": 109, "ayah": 2, "arabic": "لا أَعبُدُ ما تَعبُدونَ", "transliteration": "La aAAbudu ma taAAbudoona", "translation": "I worship not that which ye worship"}, {"surah": 109, "ayah": 3, "arabic": "وَلا أَنتُم عٰبِدونَ ما أَعبُدُ", "transliteration": "Wala antum AAabidoona ma aAAbudu", "translation": "Nor worship ye that which I worship"}, {"surah": 109, "ayah": 4, "arabic": "وَلا أَنا۠ عابِدٌ ما عَبَدتُم", "transliteration": "Wala ana AAabidun ma AAabadtum", "translation": "And I shall not worship that which ye worship"}, {"surah": 109, "ayah": 5, "arabic": "وَلا أَنتُم عٰبِدونَ ما أَعبُدُ", "transliteration": "Wala antum AAabidoona ma aAAbudu", "translation": "Nor will ye worship that which I worship"}, {"surah": 109, "ayah": 6, "arabic": "لَكُم دينُكُم وَلِىَ دينِ", "transliteration": "Lakum deenukum waliya deeni", "translation": "Unto you your religion, and unto me my religion"}]