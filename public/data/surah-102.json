[{"surah": 102, "ayah": 1, "arabic": "بِسمِ اللَّهِ الرَّحمٰنِ الرَّحيمِ أَلهىٰكُمُ التَّكاثُرُ", "transliteration": "Alhakumu alttakathuru", "translation": "Rivalry in worldly increase distracteth you"}, {"surah": 102, "ayah": 2, "arabic": "حَتّىٰ زُرتُمُ المَقابِرَ", "transliteration": "Hatta zurtumu almaqabira", "translation": "Until ye come to the graves"}, {"surah": 102, "ayah": 3, "arabic": "كَلّا سَوفَ تَعلَمونَ", "transliteration": "Kalla sawfa taAAlamoona", "translation": "Nay, but ye will come to know"}, {"surah": 102, "ayah": 4, "arabic": "ثُمَّ كَلّا سَوفَ تَعلَمونَ", "transliteration": "Thumma kalla sawfa taAAlamoona", "translation": "Nay, but ye will come to know"}, {"surah": 102, "ayah": 5, "arabic": "كَلّا لَو تَعلَمونَ عِلمَ اليَقينِ", "transliteration": "Kalla law taAAlamoona AAilma alyaqeeni", "translation": "Nay, would that ye knew (now) with a sure knowledge"}, {"surah": 102, "ayah": 6, "arabic": "لَتَرَوُنَّ الجَحيمَ", "transliteration": "Latarawunna aljaheema", "translation": "For ye will behold hell-fire"}, {"surah": 102, "ayah": 7, "arabic": "ثُمَّ لَتَرَوُنَّها عَينَ اليَقينِ", "transliteration": "Thumma latarawunnaha AAayna alyaqeeni", "translation": "Aye, ye will behold it with sure vision"}, {"surah": 102, "ayah": 8, "arabic": "ثُمَّ لَتُسـَٔلُنَّ يَومَئِذٍ عَنِ النَّعيمِ", "transliteration": "Thumma latusalunna yawmaithin AAani alnnaAAeemi", "translation": "Then, on that day, ye will be asked concerning pleasure"}]