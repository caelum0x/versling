[{"surah": 80, "ayah": 1, "arabic": "بِسمِ اللَّهِ الرَّحمٰنِ الرَّحيمِ عَبَسَ وَتَوَلّىٰ", "transliteration": "AAabasa watawalla", "translation": "He frowned and turned away"}, {"surah": 80, "ayah": 2, "arabic": "أَن جاءَهُ الأَعمىٰ", "transliteration": "An jaahu alaAAma", "translation": "Because the blind man came unto him"}, {"surah": 80, "ayah": 3, "arabic": "وَما يُدريكَ لَعَلَّهُ يَزَّكّىٰ", "transliteration": "Wama yudreeka laAAallahu yazzakka", "translation": "What could inform thee but that he might grow (in grace)"}, {"surah": 80, "ayah": 4, "arabic": "أَو يَذَّكَّرُ فَتَنفَعَهُ الذِّكرىٰ", "transliteration": "Aw yaththakkaru fatanfaAAahu alththikra", "translation": "Or take heed and so the reminder might avail him"}, {"surah": 80, "ayah": 5, "arabic": "أَمّا مَنِ استَغنىٰ", "transliteration": "Amma mani istaghna", "translation": "As for him who thinketh himself independent"}, {"surah": 80, "ayah": 6, "arabic": "فَأَنتَ لَهُ تَصَدّىٰ", "transliteration": "Faanta lahu tasadda", "translation": "Unto him thou payest regard"}, {"surah": 80, "ayah": 7, "arabic": "وَما عَلَيكَ أَلّا يَزَّكّىٰ", "transliteration": "Wama AAalayka alla yazzakka", "translation": "Yet it is not thy concern if he grow not (in grace)"}, {"surah": 80, "ayah": 8, "arabic": "وَأَمّا مَن جاءَكَ يَسعىٰ", "transliteration": "Waamma man jaaka yasAAa", "translation": "But as for him who cometh unto thee with earnest purpose"}, {"surah": 80, "ayah": 9, "arabic": "وَهُوَ يَخشىٰ", "transliteration": "Wahuwa yakhsha", "translation": "And hath fear"}, {"surah": 80, "ayah": 10, "arabic": "فَأَنتَ عَنهُ تَلَهّىٰ", "transliteration": "Faanta AAanhu talahha", "translation": "From him thou art distracted"}, {"surah": 80, "ayah": 11, "arabic": "كَلّا إِنَّها تَذكِرَةٌ", "transliteration": "Kalla innaha tathkiratun", "translation": "Nay, but verily it is an Admonishment"}, {"surah": 80, "ayah": 12, "arabic": "فَمَن شاءَ ذَكَرَهُ", "transliteration": "Faman shaa thakarahu", "translation": "So let whosoever will pay heed to it"}, {"surah": 80, "ayah": 13, "arabic": "فى صُحُفٍ مُكَرَّمَةٍ", "transliteration": "Fee suhufin mukarramatin", "translation": "On honoured leaves"}, {"surah": 80, "ayah": 14, "arabic": "مَرفوعَةٍ مُطَهَّرَةٍ", "transliteration": "MarfooAAatin mutahharatin", "translation": "Exalted, purified"}, {"surah": 80, "ayah": 15, "arabic": "بِأَيدى سَفَرَةٍ", "transliteration": "Biaydee safaratin", "translation": "(Set down) by scribes"}, {"surah": 80, "ayah": 16, "arabic": "كِرامٍ بَرَرَةٍ", "transliteration": "Kiramin bararatin", "translation": "Noble and righteous"}, {"surah": 80, "ayah": 17, "arabic": "قُتِلَ الإِنسٰنُ ما أَكفَرَهُ", "transliteration": "Qutila alinsanu ma akfarahu", "translation": "Man is (self-)destroyed: how ungrateful"}, {"surah": 80, "ayah": 18, "arabic": "مِن أَىِّ شَيءٍ خَلَقَهُ", "transliteration": "Min ayyi shayin khalaqahu", "translation": "From what thing doth He create him"}, {"surah": 80, "ayah": 19, "arabic": "مِن نُطفَةٍ خَلَقَهُ فَقَدَّرَهُ", "transliteration": "Min nutfatin khalaqahu faqaddarahu", "translation": "From a drop of seed. He createth him and proportioneth him"}, {"surah": 80, "ayah": 20, "arabic": "ثُمَّ السَّبيلَ يَسَّرَهُ", "transliteration": "Thumma alssabeela yassarahu", "translation": "Then maketh the way easy for him"}, {"surah": 80, "ayah": 21, "arabic": "ثُمَّ أَماتَهُ فَأَقبَرَهُ", "transliteration": "Thumma amatahu faaqbarahu", "translation": "Then causeth him to die, and burieth him"}, {"surah": 80, "ayah": 22, "arabic": "ثُمَّ إِذا شاءَ أَنشَرَهُ", "transliteration": "Thumma itha shaa ansharahu", "translation": "Then, when He will, He bringeth him again to life"}, {"surah": 80, "ayah": 23, "arabic": "كَلّا لَمّا يَقضِ ما أَمَرَهُ", "transliteration": "Kalla lamma yaqdi ma amarahu", "translation": "Nay, but (man) hath not done what He commanded him"}, {"surah": 80, "ayah": 24, "arabic": "فَليَنظُرِ الإِنسٰنُ إِلىٰ طَعامِهِ", "transliteration": "Falyanthuri alinsanu ila taAAamihi", "translation": "Let man consider his food"}, {"surah": 80, "ayah": 25, "arabic": "أَنّا صَبَبنَا الماءَ صَبًّا", "transliteration": "Anna sababna almaa sabban", "translation": "How We pour water in showers"}, {"surah": 80, "ayah": 26, "arabic": "ثُمَّ شَقَقنَا الأَرضَ شَقًّا", "transliteration": "Thumma shaqaqna alarda shaqqan", "translation": "Then split the earth in clefts"}, {"surah": 80, "ayah": 27, "arabic": "فَأَنبَتنا فيها حَبًّا", "transliteration": "Faanbatna feeha habban", "translation": "And cause the grain to grow therein"}, {"surah": 80, "ayah": 28, "arabic": "وَعِنَبًا وَقَضبًا", "transliteration": "WaAAinaban waqadban", "translation": "And grapes and green fodder"}, {"surah": 80, "ayah": 29, "arabic": "وَزَيتونًا وَنَخلًا", "transliteration": "Wazaytoonan wanakhlan", "translation": "And olive-trees and palm-trees"}, {"surah": 80, "ayah": 30, "arabic": "وَحَدائِقَ غُلبًا", "transliteration": "Wahadaiqa ghulban", "translation": "And garden-closes of thick foliage"}, {"surah": 80, "ayah": 31, "arabic": "وَفٰكِهَةً وَأَبًّا", "transliteration": "Wafakihatan waabban", "translation": "And fruits and grasses"}, {"surah": 80, "ayah": 32, "arabic": "مَتٰعًا لَكُم وَلِأَنعٰمِكُم", "transliteration": "MataAAan lakum walianAAamikum", "translation": "Provision for you and your cattle"}, {"surah": 80, "ayah": 33, "arabic": "فَإِذا جاءَتِ الصّاخَّةُ", "transliteration": "Faitha jaati alssakhkhatu", "translation": "But when the Shout cometh"}, {"surah": 80, "ayah": 34, "arabic": "يَومَ يَفِرُّ المَرءُ مِن أَخيهِ", "transliteration": "Yawma yafirru almaro min akheehi", "translation": "On the day when a man fleeth from his brother"}, {"surah": 80, "ayah": 35, "arabic": "وَأُمِّهِ وَأَبيهِ", "transliteration": "Waommihi waabeehi", "translation": "And his mother and his father"}, {"surah": 80, "ayah": 36, "arabic": "وَصٰحِبَتِهِ وَبَنيهِ", "transliteration": "Wasahibatihi wabaneehi", "translation": "And his wife and his children"}, {"surah": 80, "ayah": 37, "arabic": "لِكُلِّ امرِئٍ مِنهُم يَومَئِذٍ شَأنٌ يُغنيهِ", "transliteration": "Likulli imriin minhum yawmaithin shanun yughneehi", "translation": "Every man that day will have concern enough to make him heedless (of others)"}, {"surah": 80, "ayah": 38, "arabic": "وُجوهٌ يَومَئِذٍ مُسفِرَةٌ", "transliteration": "Wujoohun yawmaithin musfiratun", "translation": "On that day faces will be bright as dawn"}, {"surah": 80, "ayah": 39, "arabic": "ضاحِكَةٌ مُستَبشِرَةٌ", "transliteration": "Dahikatun mustabshiratun", "translation": "Laughing, rejoicing at good news"}, {"surah": 80, "ayah": 40, "arabic": "وَوُجوهٌ يَومَئِذٍ عَلَيها غَبَرَةٌ", "transliteration": "Wawujoohun yawmaithin AAalayha ghabaratun", "translation": "And other faces, on that day, with dust upon them"}, {"surah": 80, "ayah": 41, "arabic": "تَرهَقُها قَتَرَةٌ", "transliteration": "Tarhaquha qataratun", "translation": "Veiled in darkness"}, {"surah": 80, "ayah": 42, "arabic": "أُولٰئِكَ هُمُ الكَفَرَةُ الفَجَرَةُ", "transliteration": "Olaika humu alkafaratu alfajaratu", "translation": "Those are the disbelievers, the wicked"}]