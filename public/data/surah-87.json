[{"surah": 87, "ayah": 1, "arabic": "بِسمِ اللَّهِ الرَّحمٰنِ الرَّحيمِ سَبِّحِ اسمَ رَبِّكَ الأَعلَى", "transliteration": "Sabbihi isma rabbika alaAAla", "translation": "Praise the name of thy Lord the Most High"}, {"surah": 87, "ayah": 2, "arabic": "الَّذى خَلَقَ فَسَوّىٰ", "transliteration": "Allathee khalaqa fasawwa", "translation": "Who createth, then disposeth"}, {"surah": 87, "ayah": 3, "arabic": "وَالَّذى قَدَّرَ فَهَدىٰ", "transliteration": "Waallathee qaddara fahada", "translation": "Who measureth, then guideth"}, {"surah": 87, "ayah": 4, "arabic": "وَالَّذى أَخرَجَ المَرعىٰ", "transliteration": "Waallathee akhraja almarAAa", "translation": "Who bringeth forth the pasturage"}, {"surah": 87, "ayah": 5, "arabic": "فَجَعَلَهُ غُثاءً أَحوىٰ", "transliteration": "FajaAAalahu ghuthaan ahwa", "translation": "Then turneth it to russet stubble"}, {"surah": 87, "ayah": 6, "arabic": "سَنُقرِئُكَ فَلا تَنسىٰ", "transliteration": "Sanuqrioka fala tansa", "translation": "We shall make thee read (O Muhammad) so that thou shalt not forget"}, {"surah": 87, "ayah": 7, "arabic": "إِلّا ما شاءَ اللَّهُ إِنَّهُ يَعلَمُ الجَهرَ وَما يَخفىٰ", "transliteration": "Illa ma shaa Allahu innahu yaAAlamu aljahra wama yakhfa", "translation": "Save that which Allah willeth. Lo! He knoweth the disclosed and that which still is hidden"}, {"surah": 87, "ayah": 8, "arabic": "وَنُيَسِّرُكَ لِليُسرىٰ", "transliteration": "Wanuyassiruka lilyusra", "translation": "And We shall ease thy way unto the state of ease"}, {"surah": 87, "ayah": 9, "arabic": "فَذَكِّر إِن نَفَعَتِ الذِّكرىٰ", "transliteration": "Fathakkir in nafaAAati alththikra", "translation": "Therefor remind (men), for of use is the reminder"}, {"surah": 87, "ayah": 10, "arabic": "سَيَذَّكَّرُ مَن يَخشىٰ", "transliteration": "Sayaththakkaru man yakhsha", "translation": "He will heed who feareth"}, {"surah": 87, "ayah": 11, "arabic": "وَيَتَجَنَّبُهَا الأَشقَى", "transliteration": "Wayatajannabuha alashqa", "translation": "But the most hapless will flout it"}, {"surah": 87, "ayah": 12, "arabic": "الَّذى يَصلَى النّارَ الكُبرىٰ", "transliteration": "Allathee yasla alnnara alkubra", "translation": "He who will be flung to the great Fire"}, {"surah": 87, "ayah": 13, "arabic": "ثُمَّ لا يَموتُ فيها وَلا يَحيىٰ", "transliteration": "Thumma la yamootu feeha wala yahya", "translation": "Wherein he will neither die nor live"}, {"surah": 87, "ayah": 14, "arabic": "قَد أَفلَحَ مَن تَزَكّىٰ", "transliteration": "Qad aflaha man tazakka", "translation": "He is successful who groweth"}, {"surah": 87, "ayah": 15, "arabic": "وَذَكَرَ اسمَ رَبِّهِ فَصَلّىٰ", "transliteration": "Wathakara isma rabbihi fasalla", "translation": "And remembereth the name of his Lord, so prayeth"}, {"surah": 87, "ayah": 16, "arabic": "بَل تُؤثِرونَ الحَيوٰةَ الدُّنيا", "transliteration": "Bal tuthiroona alhayata alddunya", "translation": "But ye prefer the life of the world"}, {"surah": 87, "ayah": 17, "arabic": "وَالءاخِرَةُ خَيرٌ وَأَبقىٰ", "transliteration": "Waalakhiratu khayrun waabqa", "translation": "Although the Hereafter is better and more lasting"}, {"surah": 87, "ayah": 18, "arabic": "إِنَّ هٰذا لَفِى الصُّحُفِ الأولىٰ", "transliteration": "Inna hatha lafee alssuhufi aloola", "translation": "Lo! This is in the former scrolls"}, {"surah": 87, "ayah": 19, "arabic": "صُحُفِ إِبرٰهيمَ وَموسىٰ", "transliteration": "Suhufi ibraheema wamoosa", "translation": "The Books of Abraham and Moses"}]