[{"surah": 94, "ayah": 1, "arabic": "بِسمِ اللَّهِ الرَّحمٰنِ الرَّحيمِ أَلَم نَشرَح لَكَ صَدرَكَ", "transliteration": "Alam nashrah laka sadraka", "translation": "Have We not caused thy bosom to dilate"}, {"surah": 94, "ayah": 2, "arabic": "وَوَضَعنا عَنكَ وِزرَكَ", "transliteration": "WawadaAAna AAanka wizraka", "translation": "And eased thee of the burden"}, {"surah": 94, "ayah": 3, "arabic": "الَّذى أَنقَضَ ظَهرَكَ", "transliteration": "Allathee anqada thahraka", "translation": "Which weighed down thy back"}, {"surah": 94, "ayah": 4, "arabic": "وَرَفَعنا لَكَ ذِكرَكَ", "transliteration": "WarafaAAna laka thikraka", "translation": "And exalted thy fame"}, {"surah": 94, "ayah": 5, "arabic": "فَإِنَّ مَعَ العُسرِ يُسرًا", "transliteration": "Fainna maAAa alAAusri yusran", "translation": "But lo! with hardship goeth ease"}, {"surah": 94, "ayah": 6, "arabic": "إِنَّ مَعَ العُسرِ يُسرًا", "transliteration": "Inna maAAa alAAusri yusran", "translation": "Lo! with hardship goeth ease"}, {"surah": 94, "ayah": 7, "arabic": "فَإِذا فَرَغتَ فَانصَب", "transliteration": "Faitha faraghta fainsab", "translation": "So when thou art relieved, still toil"}, {"surah": 94, "ayah": 8, "arabic": "وَإِلىٰ رَبِّكَ فَارغَب", "transliteration": "Waila rabbika fairghab", "translation": "And strive to please thy Lord"}]