[{"surah": 101, "ayah": 1, "arabic": "بِسمِ اللَّهِ الرَّحمٰنِ الرَّحيمِ القارِعَةُ", "transliteration": "AlqariAAatu", "translation": "The Calamity"}, {"surah": 101, "ayah": 2, "arabic": "مَا القارِعَةُ", "transliteration": "Ma alqariAAatu", "translation": "What is the Calamity"}, {"surah": 101, "ayah": 3, "arabic": "وَما أَدرىٰكَ مَا القارِعَةُ", "transliteration": "Wama adraka ma alqariAAatu", "translation": "Ah, what will convey unto thee what the Calamity is"}, {"surah": 101, "ayah": 4, "arabic": "يَومَ يَكونُ النّاسُ كَالفَراشِ المَبثوثِ", "transliteration": "Yawma yakoonu alnnasu kaalfarashi almabthoothi", "translation": "A day wherein mankind will be as thickly-scattered moths"}, {"surah": 101, "ayah": 5, "arabic": "وَتَكونُ الجِبالُ كَالعِهنِ المَنفوشِ", "transliteration": "Watakoonu aljibalu kaalAAihni almanfooshi", "translation": "And the mountains will become as carded wool"}, {"surah": 101, "ayah": 6, "arabic": "فَأَمّا مَن ثَقُلَت مَوٰزينُهُ", "transliteration": "Faamma man thaqulat mawazeenuhu", "translation": "Then, as for him whose scales are heavy (with good works)"}, {"surah": 101, "ayah": 7, "arabic": "فَهُوَ فى عيشَةٍ راضِيَةٍ", "transliteration": "Fahuwa fee AAeeshatin radiyatin", "translation": "He will live a pleasant life"}, {"surah": 101, "ayah": 8, "arabic": "وَأَمّا مَن خَفَّت مَوٰزينُهُ", "transliteration": "Waamma man khaffat mawazeenuhu", "translation": "But as for him whose scales are light"}, {"surah": 101, "ayah": 9, "arabic": "فَأُمُّهُ هاوِيَةٌ", "transliteration": "Faommuhu hawiyatun", "translation": "A bereft and Hungry One will be his mother"}, {"surah": 101, "ayah": 10, "arabic": "وَما أَدرىٰكَ ما هِيَه", "transliteration": "Wama adraka ma hiyah", "translation": "Ah, what will convey unto thee what she is"}, {"surah": 101, "ayah": 11, "arabic": "نارٌ حامِيَةٌ", "transliteration": "Narun hamiyatun", "translation": "Raging Fire"}]