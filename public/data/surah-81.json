[{"surah": 81, "ayah": 1, "arabic": "بِسمِ اللَّهِ الرَّحمٰنِ الرَّحيمِ إِذَا الشَّمسُ كُوِّرَت", "transliteration": "Itha alshshamsu kuwwirat", "translation": "When the sun is overthrown"}, {"surah": 81, "ayah": 2, "arabic": "وَإِذَا النُّجومُ انكَدَرَت", "transliteration": "Waitha alnnujoomu inkadarat", "translation": "And when the stars fall"}, {"surah": 81, "ayah": 3, "arabic": "وَإِذَا الجِبالُ سُيِّرَت", "transliteration": "Waitha aljibalu suyyirat", "translation": "And when the hills are moved"}, {"surah": 81, "ayah": 4, "arabic": "وَإِذَا العِشارُ عُطِّلَت", "transliteration": "Waitha alAAisharu AAuttilat", "translation": "And when the camels big with young are abandoned"}, {"surah": 81, "ayah": 5, "arabic": "وَإِذَا الوُحوشُ حُشِرَت", "transliteration": "Waitha alwuhooshu hushirat", "translation": "And when the wild beasts are herded together"}, {"surah": 81, "ayah": 6, "arabic": "وَإِذَا البِحارُ سُجِّرَت", "transliteration": "Waitha albiharu sujjirat", "translation": "And when the seas rise"}, {"surah": 81, "ayah": 7, "arabic": "وَإِذَا النُّفوسُ زُوِّجَت", "transliteration": "Waitha alnnufoosu zuwwijat", "translation": "And when souls are reunited"}, {"surah": 81, "ayah": 8, "arabic": "وَإِذَا المَوءۥدَةُ سُئِلَت", "transliteration": "Waitha almawoodatu suilat", "translation": "And when the girl-child that was buried alive is asked"}, {"surah": 81, "ayah": 9, "arabic": "بِأَىِّ ذَنبٍ قُتِلَت", "transliteration": "Biayyi thanbin qutilat", "translation": "For what sin she was slain"}, {"surah": 81, "ayah": 10, "arabic": "وَإِذَا الصُّحُفُ نُشِرَت", "transliteration": "Waitha alssuhufu nushirat", "translation": "And when the pages are laid open"}, {"surah": 81, "ayah": 11, "arabic": "وَإِذَا السَّماءُ كُشِطَت", "transliteration": "Waitha alssamao kushitat", "translation": "And when the sky is torn away"}, {"surah": 81, "ayah": 12, "arabic": "وَإِذَا الجَحيمُ سُعِّرَت", "transliteration": "Waitha aljaheemu suAAAAirat", "translation": "And when hell is lighted"}, {"surah": 81, "ayah": 13, "arabic": "وَإِذَا الجَنَّةُ أُزلِفَت", "transliteration": "Waitha aljannatu ozlifat", "translation": "And when the Garden is brought nigh"}, {"surah": 81, "ayah": 14, "arabic": "عَلِمَت نَفسٌ ما أَحضَرَت", "transliteration": "AAalimat nafsun ma ahdarat", "translation": "(Then) every soul will know what it hath made ready"}, {"surah": 81, "ayah": 15, "arabic": "فَلا أُقسِمُ بِالخُنَّسِ", "transliteration": "Fala oqsimu bialkhunnasi", "translation": "Oh, but I call to witness the planets"}, {"surah": 81, "ayah": 16, "arabic": "الجَوارِ الكُنَّسِ", "transliteration": "Aljawari alkunnasi", "translation": "The stars which rise and set"}, {"surah": 81, "ayah": 17, "arabic": "وَالَّيلِ إِذا عَسعَسَ", "transliteration": "Waallayli itha AAasAAasa", "translation": "And the close of night"}, {"surah": 81, "ayah": 18, "arabic": "وَالصُّبحِ إِذا تَنَفَّسَ", "transliteration": "Waalssubhi itha tanaffasa", "translation": "And the breath of morning"}, {"surah": 81, "ayah": 19, "arabic": "إِنَّهُ لَقَولُ رَسولٍ كَريمٍ", "transliteration": "Innahu laqawlu rasoolin kareemin", "translation": "That this is in truth the word of an honoured messenger"}, {"surah": 81, "ayah": 20, "arabic": "ذى قُوَّةٍ عِندَ ذِى العَرشِ مَكينٍ", "transliteration": "Thee quwwatin AAinda thee alAAarshi makeenin", "translation": "Mighty, established in the presence of the Lord of the Throne"}, {"surah": 81, "ayah": 21, "arabic": "مُطاعٍ ثَمَّ أَمينٍ", "transliteration": "MutaAAin thamma ameenin", "translation": "(One) to be obeyed, and trustworthy"}, {"surah": 81, "ayah": 22, "arabic": "وَما صاحِبُكُم بِمَجنونٍ", "transliteration": "Wama sahibukum bimajnoonin", "translation": "And your comrade is not mad"}, {"surah": 81, "ayah": 23, "arabic": "وَلَقَد رَءاهُ بِالأُفُقِ المُبينِ", "transliteration": "Walaqad raahu bialofuqi almubeeni", "translation": "Surely he beheld Him on the clear horizon"}, {"surah": 81, "ayah": 24, "arabic": "وَما هُوَ عَلَى الغَيبِ بِضَنينٍ", "transliteration": "Wama huwa AAala alghaybi bidaneenin", "translation": "And he is not avid of the Unseen"}, {"surah": 81, "ayah": 25, "arabic": "وَما هُوَ بِقَولِ شَيطٰنٍ رَجيمٍ", "transliteration": "Wama huwa biqawli shaytanin rajeemin", "translation": "Nor is this the utterance of a devil worthy to be stoned"}, {"surah": 81, "ayah": 26, "arabic": "فَأَينَ تَذهَبونَ", "transliteration": "Faayna tathhaboona", "translation": "Whither then go ye"}, {"surah": 81, "ayah": 27, "arabic": "إِن هُوَ إِلّا ذِكرٌ لِلعٰلَمينَ", "transliteration": "In huwa illa thikrun lilAAalameena", "translation": "This is naught else than a reminder unto creation"}, {"surah": 81, "ayah": 28, "arabic": "لِمَن شاءَ مِنكُم أَن يَستَقيمَ", "transliteration": "Liman shaa minkum an yastaqeema", "translation": "Unto whomsoever of you willeth to walk straight"}, {"surah": 81, "ayah": 29, "arabic": "وَما تَشاءونَ إِلّا أَن يَشاءَ اللَّهُ رَبُّ العٰلَمينَ", "transliteration": "Wama tashaoona illa an yashaa Allahu rabbu alAAalameena", "translation": "And ye will not, unless (it be) that Allah willeth, the Lord of Creation"}]