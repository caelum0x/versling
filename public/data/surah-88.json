[{"surah": 88, "ayah": 1, "arabic": "بِسمِ اللَّهِ الرَّحمٰنِ الرَّحيمِ هَل أَتىٰكَ حَديثُ الغٰشِيَةِ", "transliteration": "Hal ataka hadeethu alghashiyati", "translation": "Hath there come unto thee tidings of the Overwhelming"}, {"surah": 88, "ayah": 2, "arabic": "وُجوهٌ يَومَئِذٍ خٰشِعَةٌ", "transliteration": "Wujoohun yawmaithin khashiAAatun", "translation": "On that day (many) faces will be downcast"}, {"surah": 88, "ayah": 3, "arabic": "عامِلَةٌ ناصِبَةٌ", "transliteration": "AAamilatun nasibatun", "translation": "Toiling, weary"}, {"surah": 88, "ayah": 4, "arabic": "تَصلىٰ نارًا حامِيَةً", "transliteration": "Tasla naran hamiyatan", "translation": "Scorched by burning fire"}, {"surah": 88, "ayah": 5, "arabic": "تُسقىٰ مِن عَينٍ ءانِيَةٍ", "transliteration": "Tusqa min AAaynin aniyatin", "translation": "Drinking from a boiling spring"}, {"surah": 88, "ayah": 6, "arabic": "لَيسَ لَهُم طَعامٌ إِلّا مِن ضَريعٍ", "transliteration": "Laysa lahum taAAamun illa min dareeAAin", "translation": "No food for them save bitter thorn-fruit"}, {"surah": 88, "ayah": 7, "arabic": "لا يُسمِنُ وَلا يُغنى مِن جوعٍ", "transliteration": "La yusminu wala yughnee min jooAAin", "translation": "Which doth not nourish nor release from hunger"}, {"surah": 88, "ayah": 8, "arabic": "وُجوهٌ يَومَئِذٍ ناعِمَةٌ", "transliteration": "Wujoohun yawmaithin naAAimatun", "translation": "In that day other faces will be calm"}, {"surah": 88, "ayah": 9, "arabic": "لِسَعيِها راضِيَةٌ", "transliteration": "LisaAAyiha radiyatun", "translation": "Glad for their effort past"}, {"surah": 88, "ayah": 10, "arabic": "فى جَنَّةٍ عالِيَةٍ", "transliteration": "Fee jannatin AAaliyatin", "translation": "In a high Garden"}, {"surah": 88, "ayah": 11, "arabic": "لا تَسمَعُ فيها لٰغِيَةً", "transliteration": "La tasmaAAu feeha laghiyatan", "translation": "Where they hear no idle speech"}, {"surah": 88, "ayah": 12, "arabic": "فيها عَينٌ جارِيَةٌ", "transliteration": "Feeha AAaynun jariyatun", "translation": "Wherein is a gushing spring"}, {"surah": 88, "ayah": 13, "arabic": "فيها سُرُرٌ مَرفوعَةٌ", "transliteration": "Feeha sururun marfooAAatun", "translation": "Wherein are couches raised"}, {"surah": 88, "ayah": 14, "arabic": "وَأَكوابٌ مَوضوعَةٌ", "transliteration": "Waakwabun mawdooAAatun", "translation": "And goblets set at hand"}, {"surah": 88, "ayah": 15, "arabic": "وَنَمارِقُ مَصفوفَةٌ", "transliteration": "Wanamariqu masfoofatun", "translation": "And cushions ranged"}, {"surah": 88, "ayah": 16, "arabic": "وَزَرابِىُّ مَبثوثَةٌ", "transliteration": "Wazarabiyyu mabthoothatun", "translation": "And silken carpets spread"}, {"surah": 88, "ayah": 17, "arabic": "أَفَلا يَنظُرونَ إِلَى الإِبِلِ كَيفَ خُلِقَت", "transliteration": "Afala yanthuroona ila alibili kayfa khuliqat", "translation": "Will they not regard the camels, how they are created"}, {"surah": 88, "ayah": 18, "arabic": "وَإِلَى السَّماءِ كَيفَ رُفِعَت", "transliteration": "Waila alssamai kayfa rufiAAat", "translation": "And the heaven, how it is raised"}, {"surah": 88, "ayah": 19, "arabic": "وَإِلَى الجِبالِ كَيفَ نُصِبَت", "transliteration": "Waila aljibali kayfa nusibat", "translation": "And the hills, how they are set up"}, {"surah": 88, "ayah": 20, "arabic": "وَإِلَى الأَرضِ كَيفَ سُطِحَت", "transliteration": "Waila alardi kayfa sutihat", "translation": "And the earth, how it is spread"}, {"surah": 88, "ayah": 21, "arabic": "فَذَكِّر إِنَّما أَنتَ مُذَكِّرٌ", "transliteration": "Fathakkir innama anta muthakkirun", "translation": "Remind them, for thou art but a remembrancer"}, {"surah": 88, "ayah": 22, "arabic": "لَستَ عَلَيهِم بِمُصَيطِرٍ", "transliteration": "Lasta AAalayhim bimusaytirin", "translation": "Thou art not at all a warder over them"}, {"surah": 88, "ayah": 23, "arabic": "إِلّا مَن تَوَلّىٰ وَكَفَرَ", "transliteration": "Illa man tawalla wakafara", "translation": "But whoso is averse and disbelieveth"}, {"surah": 88, "ayah": 24, "arabic": "فَيُعَذِّبُهُ اللَّهُ العَذابَ الأَكبَرَ", "transliteration": "FayuAAaththibuhu Allahu alAAathaba alakbara", "translation": "Allah will punish him with direst punishment"}, {"surah": 88, "ayah": 25, "arabic": "إِنَّ إِلَينا إِيابَهُم", "transliteration": "Inna ilayna iyabahum", "translation": "Lo! unto Us is their return"}, {"surah": 88, "ayah": 26, "arabic": "ثُمَّ إِنَّ عَلَينا حِسابَهُم", "transliteration": "Thumma inna AAalayna hisabahum", "translation": "And Ours their reckoning"}]