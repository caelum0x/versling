[{"surah": 107, "ayah": 1, "arabic": "بِسمِ اللَّهِ الرَّحمٰنِ الرَّحيمِ أَرَءَيتَ الَّذى يُكَذِّبُ بِالدّينِ", "transliteration": "Araayta allathee yukaththibu bialddeeni", "translation": "Hast thou observed him who belieth religion"}, {"surah": 107, "ayah": 2, "arabic": "فَذٰلِكَ الَّذى يَدُعُّ اليَتيمَ", "transliteration": "Fathalika allathee yaduAAAAu alyateema", "translation": "That is he who repelleth the orphan"}, {"surah": 107, "ayah": 3, "arabic": "وَلا يَحُضُّ عَلىٰ طَعامِ المِسكينِ", "transliteration": "Wala yahuddu AAala taAAami almiskeeni", "translation": "And urgeth not the feeding of the needy"}, {"surah": 107, "ayah": 4, "arabic": "فَوَيلٌ لِلمُصَلّينَ", "transliteration": "Fawaylun lilmusalleena", "translation": "Ah, woe unto worshippers"}, {"surah": 107, "ayah": 5, "arabic": "الَّذينَ هُم عَن صَلاتِهِم ساهونَ", "transliteration": "Allatheena hum AAan salatihim sahoona", "translation": "Who are heedless of their prayer"}, {"surah": 107, "ayah": 6, "arabic": "الَّذينَ هُم يُراءونَ", "transliteration": "Allatheena hum yuraoona", "translation": "Who would be seen (at worship)"}, {"surah": 107, "ayah": 7, "arabic": "وَيَمنَعونَ الماعونَ", "transliteration": "WayamnaAAoona almaAAoona", "translation": "Yet refuse small kindnesses"}]