[{"surah": 96, "ayah": 1, "arabic": "بِسمِ اللَّهِ الرَّحمٰنِ الرَّحيمِ اقرَأ بِاسمِ رَبِّكَ الَّذى خَلَقَ", "transliteration": "Iqra biismi rabbika allathee khalaqa", "translation": "Read: In the name of thy Lord Who createth"}, {"surah": 96, "ayah": 2, "arabic": "خَلَقَ الإِنسٰنَ مِن عَلَقٍ", "transliteration": "Khalaqa alinsana min AAalaqin", "translation": "Createth man from a clot"}, {"surah": 96, "ayah": 3, "arabic": "اقرَأ وَرَبُّكَ الأَكرَمُ", "transliteration": "Iqra warabbuka alakramu", "translation": "Read: And thy Lord is the Most Bounteous"}, {"surah": 96, "ayah": 4, "arabic": "الَّذى عَلَّمَ بِالقَلَمِ", "transliteration": "Allathee AAallama bialqalami", "translation": "Who teacheth by the pen"}, {"surah": 96, "ayah": 5, "arabic": "عَلَّمَ الإِنسٰنَ ما لَم يَعلَم", "transliteration": "AAallama alinsana ma lam yaAAlam", "translation": "Teacheth man that which he knew not"}, {"surah": 96, "ayah": 6, "arabic": "كَلّا إِنَّ الإِنسٰنَ لَيَطغىٰ", "transliteration": "Kalla inna alinsana layatgha", "translation": "Nay, but verily man is rebellious"}, {"surah": 96, "ayah": 7, "arabic": "أَن رَءاهُ استَغنىٰ", "transliteration": "An raahu istaghna", "translation": "That he thinketh himself independent"}, {"surah": 96, "ayah": 8, "arabic": "إِنَّ إِلىٰ رَبِّكَ الرُّجعىٰ", "transliteration": "Inna ila rabbika alrrujAAa", "translation": "Lo! unto thy Lord is the return"}, {"surah": 96, "ayah": 9, "arabic": "أَرَءَيتَ الَّذى يَنهىٰ", "transliteration": "Araayta allathee yanha", "translation": "Hast thou seen him who dissuadeth"}, {"surah": 96, "ayah": 10, "arabic": "عَبدًا إِذا صَلّىٰ", "transliteration": "AAabdan itha salla", "translation": "A slave when he prayeth"}, {"surah": 96, "ayah": 11, "arabic": "أَرَءَيتَ إِن كانَ عَلَى الهُدىٰ", "transliteration": "Araayta in kana AAala alhuda", "translation": "Hast thou seen if he relieth on the guidance (of Allah)"}, {"surah": 96, "ayah": 12, "arabic": "أَو أَمَرَ بِالتَّقوىٰ", "transliteration": "Aw amara bialttaqwa", "translation": "Or enjoineth piety"}, {"surah": 96, "ayah": 13, "arabic": "أَرَءَيتَ إِن كَذَّبَ وَتَوَلّىٰ", "transliteration": "Araayta in kaththaba watawalla", "translation": "Hast thou seen if he denieth (Allah's guidance) and is froward"}, {"surah": 96, "ayah": 14, "arabic": "أَلَم يَعلَم بِأَنَّ اللَّهَ يَرىٰ", "transliteration": "Alam yaAAlam bianna Allaha yara", "translation": "Is he then unaware that Allah seeth"}, {"surah": 96, "ayah": 15, "arabic": "كَلّا لَئِن لَم يَنتَهِ لَنَسفَعًا بِالنّاصِيَةِ", "transliteration": "Kalla lain lam yantahi lanasfaAAan bialnnasiyati", "translation": "Nay, but if he cease not We will seize him by the forelock"}, {"surah": 96, "ayah": 16, "arabic": "ناصِيَةٍ كٰذِبَةٍ خاطِئَةٍ", "transliteration": "Nasiyatin kathibatin khatiatin", "translation": "The lying, sinful forelock"}, {"surah": 96, "ayah": 17, "arabic": "فَليَدعُ نادِيَهُ", "transliteration": "FalyadAAu nadiyahu", "translation": "Then let him call upon his henchmen"}, {"surah": 96, "ayah": 18, "arabic": "سَنَدعُ الزَّبانِيَةَ", "transliteration": "SanadAAu alzzabaniyata", "translation": "We will call the guards of hell"}, {"surah": 96, "ayah": 19, "arabic": "كَلّا لا تُطِعهُ وَاسجُد وَاقتَرِب", "transliteration": "Kalla la tutiAAhu waosjud waiqtarib", "translation": "Nay, Obey not thou him. But prostrate thyself, and draw near (unto Allah)"}]